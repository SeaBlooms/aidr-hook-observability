# Copy to .env and fill in. Do not commit .env.
# Read by `aidr-obs serve` only (the tap never loads it), and only JEV_* keys.
# Values already exported in the shell win over this file.

# Same value as JEV_API_TOKEN in jevai-dev-lab/.env
JEV_API_TOKEN=
# Loopback only
JEV_BASE_URL=http://127.0.0.1:8790
