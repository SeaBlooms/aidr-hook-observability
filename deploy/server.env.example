# ~/aidr-stack/.env on the server. chmod 600. Never commit the filled-in copy.
# Generate tokens with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# The Mac shipper sends this as a bearer token (same value in ~/.aidr-obs/ship.env on the Mac).
AIDR_OBS_PUSH_TOKEN=

# Shared by the dashboard and Jev.
JEV_API_TOKEN=

# Jev only.
AI_GATEWAY_API_KEY=
JEV_MODEL=anthropic/claude-sonnet-5
JEV_BACKEND=gateway
# Native Ollama on the Docker host (OLLAMA_HOST=0.0.0.0:11434 in its systemd override).
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=300

# Time zone for container logs, e.g. America/Los_Angeles.
TZ=UTC

# Optional: pin images instead of :latest, e.g. ghcr.io/seablooms/aidr-obs:sha-abc1234
# AIDR_OBS_IMAGE=
# JEV_IMAGE=
