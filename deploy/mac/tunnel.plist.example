<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SSH tunnel to the aidr-obs and Jev containers on the server's loopback.
  Copy to ~/Library/LaunchAgents/com.seablooms.aidr-obs.tunnel.plist, replace `vanishai`
  if your ~/.ssh/config Host alias differs, then:
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.seablooms.aidr-obs.tunnel.plist
  The SSH key must work without a prompt (no passphrase, or one stored in the macOS keychain).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.seablooms.aidr-obs.tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/ssh</string>
    <string>-N</string>
    <string>-o</string><string>BatchMode=yes</string>
    <string>-o</string><string>ServerAliveInterval=30</string>
    <string>-o</string><string>ServerAliveCountMax=3</string>
    <string>-o</string><string>ExitOnForwardFailure=yes</string>
    <string>-L</string><string>127.0.0.1:8770:127.0.0.1:8770</string>
    <string>-L</string><string>127.0.0.1:8790:127.0.0.1:8790</string>
    <string>vanishai</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardErrorPath</key>
  <string>/tmp/aidr-obs-tunnel.log</string>
</dict>
</plist>
