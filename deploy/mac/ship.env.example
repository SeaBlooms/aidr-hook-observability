# ~/.aidr-obs/ship.env on the Mac. chmod 600. Read by `aidr-obs ship`.
# Same value as AIDR_OBS_PUSH_TOKEN in the server's ~/aidr-stack/.env
AIDR_OBS_PUSH_TOKEN=
# The SSH tunnel's local end. Plain http is refused for anything but loopback.
AIDR_OBS_PUSH_URL=http://127.0.0.1:8770
# Optional: this Mac's name on the server (default: the hostname).
# Each Mac keeps its own byte offset. Set this only when two Macs share a hostname.
# AIDR_OBS_SHIP_DEVICE=
